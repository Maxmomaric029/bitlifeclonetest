{
  "system": "school_grade_system",
  "note": "Sistema de notas de la escuela/colegio. Los eventos de examen viven en el mismo archivo y comparten el pool 'school'.",
  "gradeSystem": {
    "scale": { "min": 0, "max": 100, "passing": 65, "honorRoll": 90, "promotion": 65 },
    "subjects": [
      "Matemáticas",
      "Lengua Española",
      "Ciencias Sociales",
      "Ciencias Naturales",
      "Inglés",
      "Educación Física",
      "Artes",
      "Informática",
      "Formación Humana y Religiosa"
    ],
    "gradeBands": [
      { "letter": "A", "min": 90, "max": 100, "label": "Sobresaliente" },
      { "letter": "B", "min": 80, "max": 89, "label": "Muy bueno" },
      { "letter": "C", "min": 65, "max": 79, "label": "Aprobado" },
      { "letter": "D", "min": 55, "max": 64, "label": "En riesgo" },
      { "letter": "F", "min": 0, "max": 54, "label": "Reprobado" }
    ],
    "points": { "A": 4.0, "B": 3.0, "C": 2.0, "D": 1.0, "F": 0.0 },
    "stageWeighting": {
      "primary": { "examen": 0.3, "tarea": 0.3, "participacion": 0.2, "asistencia": 0.2 },
      "secondary": { "examen": 0.4, "tarea": 0.25, "participacion": 0.15, "asistencia": 0.1, "disciplina": 0.1 },
      "university": { "examen": 0.55, "tarea": 0.25, "participacion": 0.1, "asistencia": 0.1 }
    },
    "examDifficultyByAge": [
      { "ageMin": 8, "ageMax": 11, "multiplier": 0.9 },
      { "ageMin": 12, "ageMax": 15, "multiplier": 1.0 },
      { "ageMin": 16, "ageMax": 18, "multiplier": 1.15 },
      { "ageMin": 19, "ageMax": 22, "multiplier": 1.25 }
    ],
    "gradeEffects": {
      "gradesDeltaPerSmarts": 0.5,
      "maxGradesDelta": 12,
      "minGradesDelta": -12,
      "stressPenaltyAtBurnout": 8
    },
    "yearEndRules": [
      { "id": "gs_promoted", "when": "grades >= 65 y attendance >= 60", "description": "Pasa de curso sin problemas.", "flagsAdd": [], "flagsRemove": [] },
      { "id": "gs_honor", "when": "grades >= 90 y discipline >= 70", "description": "Entra al cuadro de honor del colegio.", "flagsAdd": ["HONOR_ROLL"], "flagsRemove": [] },
      { "id": "gs_repeat", "when": "grades < 65", "description": "Repite el año.", "flagsAdd": ["REPEATED_YEAR"], "flagsRemove": [] },
      { "id": "gs_truancy", "when": "attendance < 60", "description": "Riesgo por ausencias; la escuela cita al tutor.", "flagsAdd": ["TRUANT"], "flagsRemove": [] },
      { "id": "gs_suspension", "when": "discipline < 30", "description": "Suspensión de varios días.", "flagsAdd": ["SUSPENDED"], "flagsRemove": [] },
      { "id": "gs_expulsion", "when": "discipline < 10 o 3 suspensiones en el año", "description": "Expulsión del centro.", "flagsAdd": ["EXPELLED"], "flagsRemove": [] },
      { "id": "gs_dropout", "when": "EXPELLED y sin reinscripción en el año", "description": "Abandono definitivo de la escuela.", "flagsAdd": ["DROPPED_OUT"], "flagsRemove": [] },
      { "id": "gs_burnout", "when": "stress >= 85 durante 3 meses seguidos en etapa escolar", "description": "Agotamiento académico.", "flagsAdd": ["BURNOUT"], "flagsRemove": [] },
      { "id": "gs_gift", "when": "grades >= 90 tres años seguidos", "description": "La escuela te pasa al programa de talento.", "flagsAdd": ["GIFTED"], "flagsRemove": [] }
    ]
  },
