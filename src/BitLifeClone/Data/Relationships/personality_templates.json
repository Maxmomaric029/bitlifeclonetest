      { "id": "tpl_drift_prison", "trigger": "flag IN_PRISON al cerrar el ano", "adds": { "manipulative": 10, "strict": 6 }, "addsTo": "player" },
      { "id": "tpl_drift_faith", "trigger": "3+ acciones religiosas en el ano", "adds": { "religious": 12 }, "addsTo": "player" }
    ]
