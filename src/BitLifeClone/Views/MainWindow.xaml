<Window x:Class="BitLifeClone.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BitLifeClone"
        Height="720" Width="480"
        MinHeight="600" MinWidth="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"
              xmlns:converters="clr-namespace:BitLifeClone.Converters" />
    </Window.Resources>
    <Grid>
        <!-- ================================================================= JUEGO -->
        <Grid Visibility="{Binding HasGame, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- header -->
                <RowDefinition Height="*" />      <!-- feed -->
                <RowDefinition Height="Auto" />   <!-- barras -->
                <RowDefinition Height="Auto" />   <!-- botones -->
            </Grid.RowDefinitions>

            <!-- Header: avatar + nombre + pais/ano + dinero -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Avatar}"
                               FontSize="34" VerticalAlignment="Center" Margin="0,0,12,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TitleLine}" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="{Binding SubLine}"
                                   Style="{StaticResource SecondaryLabel}" />
                        <TextBlock Text="{Binding JobLine}"
                                   Style="{StaticResource SecondaryLabel}" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding MoneyText}"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Feed central (el mas nuevo arriba) -->
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Feed}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="10,8"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceBrush}"
                                CornerRadius="8" Padding="10,8" Margin="0,3">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding AgeLabel}"
                                               FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding Text}"
                                               TextWrapping="Wrap"
                                               FontSize="14"
                                               Foreground="{StaticResource PrimaryTextBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Detail}"
                                           TextWrapping="Wrap" FontSize="12.5"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="0,3,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding DeltasLabel}" FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource AccentBrush}"
                                           Margin="0,3,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Barras de stats -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" Padding="12,8">
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,2,10,2">
                        <TextBlock Text="😊 Felicidad" Style="{StaticResource SecondaryLabel}" />
                        <ProgressBar Value="{Binding Happiness}" Maximum="100" Height="9"
                                     Foreground="#FF4DD0E1" Background="#FF333333" />
                    </StackPanel>
                    <StackPanel Margin="10,2,0,2">
                        <TextBlock Text="❤️ Salud" Style="{StaticResource SecondaryLabel}" />
                        <ProgressBar Value="{Binding Health}" Maximum="100" Height="9"
                                     Foreground="#FFE57373" Background="#FF333333" />
                    </StackPanel>
                    <StackPanel Margin="0,2,10,2">
                        <TextBlock Text="🧠 Inteligencia" Style="{StaticResource SecondaryLabel}" />
                        <ProgressBar Value="{Binding Smarts}" Maximum="100" Height="9"
                                     Foreground="#FFBA68C8" Background="#FF333333" />
                    </StackPanel>
                    <StackPanel Margin="10,2,0,2">
                        <TextBlock Text="✨ Apariencia" Style="{StaticResource SecondaryLabel}" />
                        <ProgressBar Value="{Binding Looks}" Maximum="100" Height="9"
                                     Foreground="#FFFFB74D" Background="#FF333333" />
                    </StackPanel>
                </UniformGrid>
            </Border>

            <!-- Botones -->
            <Grid Grid.Row="3" Background="{StaticResource SurfaceBrush}" Margin="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="+ Edad"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding AgeUpCommand}"
                        FontSize="16" FontWeight="Bold" Margin="8,6" />
                <Button Grid.Column="1" Content="🎮 Trayectoria"
                        Style="{StaticResource SurfaceButton}"
                        Command="{Binding OpenMenuCommand}" CommandParameter="activities"
                        FontSize="10.5" Margin="4,6" />
                <Button Grid.Column="2" Content="💼 Trabajo"
                        Style="{StaticResource SurfaceButton}"
                        Command="{Binding OpenMenuCommand}" CommandParameter="jobs"
                        FontSize="10.5" Margin="4,6" />
                <Button Grid.Column="3" Content="❤️ Relaciones"
                        Style="{StaticResource SurfaceButton}"
                        Command="{Binding OpenMenuCommand}" CommandParameter="relations"
                        FontSize="10.5" Margin="4,6" />
            </Grid>

            <!-- Overlay de menus -->
            <Grid Visibility="{Binding OptionsVisible, Converter={StaticResource BoolToVis}}"
                  Grid.Row="0" Grid.RowSpan="4">
                <Grid Background="#B8000000" />
                <Border Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource PrimaryBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Width="380" Height="500"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="14">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding OptionsTitle}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   Margin="4,0,0,10" />
                        <ListBox ItemsSource="{Binding Options}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button HorizontalContentAlignment="Stretch"
                                            Command="{Binding Command}"
                                            Style="{StaticResource SurfaceButton}"
                                            Margin="0,3">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Text}" TextAlignment="Left" />
                                            <TextBlock Text="{Binding Sub}"
                                                       TextAlignment="Left" FontSize="11"
                                                       Foreground="{StaticResource SecondaryTextBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Overlay de muerte -->
            <Grid Grid.Row="0" Grid.RowSpan="4">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlayerDead}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid Background="#B8000000" />
                <Border Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource DangerBrush}"
                        BorderThickness="1" CornerRadius="12"
                        Width="340" Height="260"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="20">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="☠️ Fin de la vida" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding TitleLine}" FontSize="15"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                        <Button Content="🆕 Nueva vida" Style="{StaticResource PrimaryButton}"
                                Command="{Binding NewLifeCommand}" Margin="0,20,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================================================ INICIO -->
        <Border Visibility="{Binding HasGame, Converter={StaticResource InverseBoolToVis}}"
                Background="{StaticResource BackgroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,20">
                    <TextBlock Text="🤰 Hoja en blanco" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               HorizontalAlignment="Center" Margin="0,10" />
                    <TextBlock Text="Nombre del personaje" Style="{StaticResource SecondaryLabel}"
                               Margin="0,16,0,4" />
                    <TextBox Text="{Binding StartName, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="15" Padding="8"
                             Background="#FF2A2A2A" Foreground="{StaticResource PrimaryTextBrush}"
                             BorderBrush="{StaticResource PrimaryBrush}" />

                    <TextBlock Text="Género" Style="{StaticResource SecondaryLabel}"
                               Margin="0,14,0,4" />
                    <UniformGrid Columns="2">
                        <Button Content="👨 Masculino" FontSize="14" Margin="0,0,4,0"
                                Command="{Binding SetGenderCommand}" CommandParameter="Male">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SurfaceButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMaleSelected}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="👩 Femenino" FontSize="14" Margin="4,0,0,0"
                                Command="{Binding SetGenderCommand}" CommandParameter="Female">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SurfaceButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFemaleSelected}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </UniformGrid>

                    <TextBlock Text="País" Style="{StaticResource SecondaryLabel}"
                               Margin="0,14,0,4" />
                    <ComboBox ItemsSource="{Binding Countries}"
                              SelectedItem="{Binding SelectedCountry}"
                              FontSize="14" Padding="8" />

                    <Button Content="🚀 Comenzar vida" Style="{StaticResource PrimaryButton}"
                            Command="{Binding StartCommand}" FontSize="16"
                            Margin="0,20,0,0" />

                    <TextBlock Text="Partidas guardadas" Style="{StaticResource SecondaryLabel}"
                               Margin="0,24,0,4" />
                    <ListBox ItemsSource="{Binding Saves}"
                             Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SurfaceButton}"
                                        HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.LoadSaveCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding FileName}"
                                        Margin="0,2,0,2">
                                    <TextBlock Text="{Binding Label}" TextAlignment="Left" TextWrapping="Wrap" />
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Content="🔄 Refrescar lista" Style="{StaticResource SurfaceButton}"
                            Command="{Binding RefreshSavesCommand}" FontSize="12"
                            Margin="0,8,0,20" HorizontalAlignment="Left" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
